{
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@noble/ciphers": "^1.2.1",
    "@noble/post-quantum": "^0.4.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@qorechain/sdk": "^0.14.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.0.0",
    "wagmi": "^2.19.5"
  },
  "description": "QoreRollup: a minimal post-quantum rollup on the QoreChain testnet (qorechain-diana). An off-chain sequencer batches transactions, signs each batch with ML-DSA-87, and settles it on a contract that verifies the signature via the pqcVerify precompile; withdrawals, a watchtower, and ML-KEM-1024 batch data protection complete the Protocol Builders entry.",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "chai": "^4.4.1",
    "ethers": "^6.13.4",
    "hardhat": "^2.22.17",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  },
  "name": "qorerollup",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "prebuild": "node scripts/gen-evidence.mjs",
    "render-check": "node scripts/render-check.mjs",
    "compile": "hardhat compile",
    "deploy": "tsx --env-file=../.env scripts/deploy.ts",
    "dev": "vite",
    "preview": "vite preview",
    "sequencer": "tsx --env-file=../.env scripts/sequencer.ts",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.app.json",
    "usage": "tsx --env-file=../.env scripts/usage.ts",
    "merkle-withdraw": "tsx --env-file=../.env.user scripts/merkle-withdraw.ts",
    "watchtower": "tsx --env-file=../.env scripts/watchtower.ts",
    "window": "tsx --env-file=../.env scripts/window.ts",
    "forged-batch": "tsx --env-file=../.env scripts/forged-batch.ts"
  },
  "version": "1.0.0"
}
